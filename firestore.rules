rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 賓果卡池集合：cards/{slotId} (slotId 為 "0001" ~ "0100")
    match /cards/{slotId} {
      // 允許前端讀取單張卡片或即時監聽戰況
      allow get: if true;
      allow list: if true;

      // 允許兩種安全更新情境，嚴格禁止竄改卡片盤面與卡號本身：
      // 1. 首次原子搶卡：原本 claimed == false -> 更新為 claimed == true
      // 2. 已領卡的同裝置回報目前手機標記進度 (reportedLines, reportedMarked, reportedMarkedCount, reportedAt)
      allow update: if request.resource.data.cardId == resource.data.cardId
                    && request.resource.data.cardNo == resource.data.cardNo
                    && request.resource.data.grid == resource.data.grid
                    && request.resource.data.signature == resource.data.signature
                    && (
                      (
                        resource.data.claimed == false
                        && request.resource.data.claimed == true
                        && request.resource.data.claimedBy is string
                        && request.resource.data.claimedBy.size() >= 8
                      )
                      ||
                      (
                        resource.data.claimed == true
                        && request.resource.data.claimed == true
                        && request.resource.data.claimedBy == resource.data.claimedBy
                      )
                    );

      // 初始化題庫時可短暫開啟 create，正式活動開始前建議改為 false
      allow create: if true;
      allow delete: if false;
    }
  }
}
